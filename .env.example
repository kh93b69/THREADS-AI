# ─── Poster Service (Meta / Threads Graph API) ───────────────────────────────
# Long-lived User Access Token (живёт 60 дней, продлевается через /refresh_access_token)
THREADS_ACCESS_TOKEN=
# Числовой ID аккаунта Threads (получается из GET /v1.0/me?fields=id)
THREADS_USER_ID=
# Версия Graph API Threads
THREADS_API_VERSION=v1.0

# ─── LLM (генерация текста поста) ───────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# ─── Parser Service (Apify) ─────────────────────────────────────────────────
APIFY_TOKEN=
# Actor id для скрейпинга Threads (напр. "apify/threads-scraper")
APIFY_ACTOR_ID=

# ─── Прочее ─────────────────────────────────────────────────────────────────
# true = ничего не публикуем реально, только логируем запросы
DRY_RUN=false
LOG_LEVEL=info

# ─── HTTP-сервер (Railway) ──────────────────────────────────────────────────
# Railway подставляет PORT сам; локально по умолчанию 3000
PORT=3000
# Общий секрет: заголовок x-api-secret у /publish и /parse. Придумай длинную строку.
API_SECRET=
