# ─── Poster Service (Meta / Threads Graph API) ───────────────────────────────
# Long-lived User Access Token (живёт 60 дней, продлевается через /refresh_access_token)
THREADS_ACCESS_TOKEN=
# Числовой ID аккаунта Threads (получается из GET /v1.0/me?fields=id)
THREADS_USER_ID=
# Версия Graph API Threads
THREADS_API_VERSION=v1.0

# ─── LLM (генерация текста поста) ───────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# ─── Parser Service (Apify) ─────────────────────────────────────────────────
APIFY_TOKEN=
# Actor id для скрейпинга Threads (напр. "apify/threads-scraper")
APIFY_ACTOR_ID=

# ─── Прочее ─────────────────────────────────────────────────────────────────
# true = ничего не публикуем реально, только логируем запросы
DRY_RUN=false
LOG_LEVEL=info

# ─── HTTP-сервер (Railway) ──────────────────────────────────────────────────
# Railway подставляет PORT сам; локально по умолчанию 3000
PORT=3000
# Общий секрет: заголовок x-api-secret у /publish и /parse. Придумай длинную строку.
API_SECRET=

# ─── Автопостинг ────────────────────────────────────────────────────────────
# Главный выключатель: true — бот постит сам по расписанию
AUTOPOST_ENABLED=false
# Времена публикации через запятую, в зоне TIMEZONE
POST_TIMES=10:00,19:00
# IANA-зона: Europe/Moscow, Asia/Yekaterinburg, Europe/Berlin...
TIMEZONE=Europe/Moscow

# ─── OAuth: получение токена Meta через /auth/start ─────────────────────────
# Публичный адрес сервиса. Из него собирается redirect URI: <PUBLIC_URL>/auth/callback
PUBLIC_URL=https://threads-ai-production.up.railway.app
# Threads app ID и secret — из Настроек приложения, НЕ ID основного приложения Meta
THREADS_APP_ID=
THREADS_APP_SECRET=
# Необязательно: redirect URI ровно как в настройках Meta (если там есть слеш в конце).
# Если не задан — собирается как <PUBLIC_URL>/auth/callback
THREADS_REDIRECT_URI=

# ─── Телеграм-уведомления ───────────────────────────────────────────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Твой chat_id — узнать можно на странице /tg/setup
TELEGRAM_CHAT_ID=
# Время ежедневной сводки (в зоне TIMEZONE). Пусто = 21:00
DIGEST_TIME=21:00
# Выключить сводку: false. По умолчанию включена, если настроен Телеграм.
DIGEST_ENABLED=
